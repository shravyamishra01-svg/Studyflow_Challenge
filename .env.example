# ==============================================================================
# StudyFlow Environment Configuration
# ==============================================================================

# Required: Google Gemini API Key
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=[ENCRYPTION_KEY]

# Optional: Preferred Gemini Model
# Supported: gemini-2.5-flash (default, fast & strictly grounded), gemini-3.7-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Server Port (default: 8000)
PORT=8000
